--- !u!114 &3639758286985656071
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3320029973866642767}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c63fc85f6488d8499a6b5489a8f2d43, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _textSound: {fileID: 7066261977287309210}
  _textBox: {fileID: 4704422291464798471}
  _text: "\u041F\u0440\u0438\u0432\u0435\u0442! \u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
    \u0432 \u0438\u0433\u0440\u0443. \u0412\u0430\u0448\u0430 \u0446\u0435\u043B\u044C
    - \u043F\u043E\u043C\u043E\u0447\u044C \u043C\u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u0440\u0430\u043A\u0435\u0442\u0443 \u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
    \u043D\u0430 \u0440\u043E\u0434\u043D\u0443\u044E \u043F\u043B\u0430\u043D\u0435\u0442\u0443.
    \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E
    \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0440\u0435\u0441\u0443\u0440\u0441\u044B
    \u0438 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0431\u0430\u0437\u0443. \u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043B\u0435
    \u043F\u043E\u043B\u043D\u043E\u0439 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0430\u0446\u0438\u0438
    \u0431\u0430\u0437\u044B \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
    \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0440\u0430\u043A\u0435\u0442\u0443."
--- !u!114 &104651776077993261
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3320029973866642767}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dbf51be86e70d7941bd40914206e4ddc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  translationName: First tutorial window
  FallbackText: 'Hello! And welcome to the game.

    Your goal is to help me build
    the rocket and return to my home planet.

    In order to do that you need to
    collect resources and upgrade the base. Only after fully upgrading the base you
    can build the Rocket. '
