--- !u!114 &8338320746795223567
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4497643455189913687}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c63fc85f6488d8499a6b5489a8f2d43, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _textSound: {fileID: 7066261977287309210}
  _textBox: {fileID: 3611495561343367295}
  _text: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0438\u0433\u0440\u044B \u0432\u044B
    \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C
    \u0442\u043E\u043B\u044C\u043A\u043E \u0436\u0435\u043B\u0435\u0437\u043E, \u043D\u043E
    \u043F\u043E\u0441\u043B\u0435 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
    \u043E\u0440\u0443\u0436\u0438\u044F \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
    \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0431\u043E\u043B\u0435\u0435
    \u0440\u0435\u0434\u043A\u0438\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B. 
    \u0412\u0441\u0435 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B
    \u043D\u0443\u0436\u043D\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C
    \u043D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443 \"\u041F\u0440\u043E\u0434\u0430\u0442\u044C\",
    \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u0437\u043E\u043B\u043E\u0442\u043E. \u0417\u043E\u043B\u043E\u0442\u043E -
    \u043D\u0430\u0448\u0430 \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0432\u0430\u043B\u044E\u0442\u0430
    \u0434\u043B\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0439. \u0422\u0430\u043A\u0436\u0435
    \u043F\u043E\u0441\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
    \u0432\u044B \u0431\u0443\u0434\u0435\u0442\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C
    \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u044F\u0449\u0438\u043A\u0438 \u0441 \u0437\u043E\u043B\u043E\u0442\u043E\u043C,
    \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043C\u043E\u0447\u044C \u0432\u0430\u043C
    \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0434\u043E\u0441\u0442\u0438\u0447\u044C
    \u0446\u0435\u043B\u0438!"
--- !u!114 &1996991320066407876
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
