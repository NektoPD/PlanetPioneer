  entries:
  - Language: English
    Text: Cannot catch more Alien Artifact. Maximum capacity reached.
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0439\u043C\u0430\u0442\u044C
