--- !u!114 &875016513287666095
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8269389491282874570}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: "At start you can only collect Iron but after upgrading the weapon you
      can collect more rare resources. \nPlease return all the resources you collect
      to the Selling plane to receive gold.\nGold is our main currency for upgrade.\nAlso
      after every upgrade you will receive additional crate with gold to help you
      reach the goal faster!"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0438\u0433\u0440\u044B \u0432\u044B
      \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u0436\u0435\u043B\u0435\u0437\u043E,
      \u043D\u043E \u043F\u043E\u0441\u043B\u0435 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
      \u043E\u0440\u0443\u0436\u0438\u044F \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
      \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0431\u043E\u043B\u0435\u0435
      \u0440\u0435\u0434\u043A\u0438\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B.
      \n\u0412\u0441\u0435 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435
      \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u043D\u0443\u0436\u043D\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C
      \u043D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443 \"\u041F\u0440\u043E\u0434\u0430\u0442\u044C\",
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0437\u043E\u043B\u043E\u0442\u043E.\n\u0417\u043E\u043B\u043E\u0442\u043E
      - \u043D\u0430\u0448\u0430 \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
      \u0432\u0430\u043B\u044E\u0442\u0430 \u0434\u043B\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0439.\n\u0422\u0430\u043A\u0436\u0435
      \u043F\u043E\u0441\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
      \u0432\u044B \u0431\u0443\u0434\u0435\u0442\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u044F\u0449\u0438\u043A\u0438 \u0441 \u0437\u043E\u043B\u043E\u0442\u043E\u043C,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043C\u043E\u0447\u044C \u0432\u0430\u043C
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0434\u043E\u0441\u0442\u0438\u0447\u044C
      \u0446\u0435\u043B\u0438!"
    Object: {fileID: 0}
  - Language: Turkish
    Text: "Ba\u015Flang\u0131\xE7ta sadece Demir toplayabilirsiniz, ancak silah\u0131
      y\xFCkselttikten sonra daha nadir kaynaklar toplayabilirsiniz. \nAlt\u0131n
      almak i\xE7in l\xFCtfen toplad\u0131\u011F\u0131n\u0131z t\xFCm kaynaklar\u0131
      Sat\u0131\u015F d\xFCzlemine iade edin.\nAlt\u0131n, y\xFCkseltme i\xE7in ana
      para birimimizdir.\nAyr\u0131ca her y\xFCkseltmeden sonra hedefe daha h\u0131zl\u0131
      ula\u015Fman\u0131za yard\u0131mc\u0131 olmak i\xE7in alt\u0131n i\xE7eren
      ek sand\u0131k alacaks\u0131n\u0131z!"
    Object: {fileID: 0}
