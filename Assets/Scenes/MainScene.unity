    - target: {fileID: 4704422291464798471, guid: 263a4554271319a419b5490a6e9aaefa, type: 3}
      propertyPath: m_text
      value: 'Hello! And welcome to the game.

        Your goal is to help me build
        the rocket and return to my home planet.

        In order to do that you
        need to collect resources and upgrade the base. Only after fully upgrading
        the base you can build the Rocket. '
      objectReference: {fileID: 0}
