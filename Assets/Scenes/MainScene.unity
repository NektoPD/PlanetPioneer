--- !u!1001 &5803598606691593901
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 363085463}
    m_Modifications:
    - target: {fileID: 3611495561343367295, guid: 263a4554271319a419b5490a6e9aaefa, type: 3}
      propertyPath: m_text
      value: "\u0412 \u043D\u0430\u0447\u0430\u043B\u0435 \u0438\u0433\u0440\u044B
        \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C
        \u0442\u043E\u043B\u044C\u043A\u043E \u0436\u0435\u043B\u0435\u0437\u043E,
        \u043D\u043E \u043F\u043E\u0441\u043B\u0435 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
        \u043E\u0440\u0443\u0436\u0438\u044F \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
        \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0431\u043E\u043B\u0435\u0435
        \u0440\u0435\u0434\u043A\u0438\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B.
        \n\u0412\u0441\u0435 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435
        \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u043D\u0443\u0436\u043D\u043E
        \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C \u043D\u0430
        \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443 \"\u041F\u0440\u043E\u0434\u0430\u0442\u044C\",
        \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
        \u0437\u043E\u043B\u043E\u0442\u043E.\n\u0417\u043E\u043B\u043E\u0442\u043E
        - \u043D\u0430\u0448\u0430 \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
        \u0432\u0430\u043B\u044E\u0442\u0430 \u0434\u043B\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0439.\n\u0422\u0430\u043A\u0436\u0435
        \u043F\u043E\u0441\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
        \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u0432\u044B \u0431\u0443\u0434\u0435\u0442\u0435
        \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
        \u044F\u0449\u0438\u043A\u0438 \u0441 \u0437\u043E\u043B\u043E\u0442\u043E\u043C,
        \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043C\u043E\u0447\u044C \u0432\u0430\u043C
        \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0434\u043E\u0441\u0442\u0438\u0447\u044C
        \u0446\u0435\u043B\u0438!"
      objectReference: {fileID: 0}
    - target: {fileID: 4704422291464798471, guid: 263a4554271319a419b5490a6e9aaefa, type: 3}
      propertyPath: m_text
      value: "\u041F\u0440\u0438\u0432\u0435\u0442! \u0414\u043E\u0431\u0440\u043E
        \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C \u0432 \u0438\u0433\u0440\u0443.\n\u0412\u0430\u0448\u0430
        \u0446\u0435\u043B\u044C - \u043F\u043E\u043C\u043E\u0447\u044C \u043C\u043D\u0435
        \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0440\u0430\u043A\u0435\u0442\u0443
        \u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043D\u0430
        \u0440\u043E\u0434\u043D\u0443\u044E \u043F\u043B\u0430\u043D\u0435\u0442\u0443.\n\u0414\u043B\u044F
        \u044D\u0442\u043E\u0433\u043E \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E
        \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0440\u0435\u0441\u0443\u0440\u0441\u044B
        \u0438 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
        \u0431\u0430\u0437\u0443. \u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043B\u0435
        \u043F\u043E\u043B\u043D\u043E\u0439 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0430\u0446\u0438\u0438
        \u0431\u0430\u0437\u044B \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
        \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0440\u0430\u043A\u0435\u0442\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 6145169148155867722, guid: 263a4554271319a419b5490a6e9aaefa, type: 3}
      propertyPath: m_LocalPosition.x
